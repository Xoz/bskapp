# Miljövariabler för BSK-appen. Använd .env.development.local för lokal utveckling.

# --- Databas (Postgres) ---
# Lokal utveckling ska använda en separat utvecklingsdatabas.
# Produktion kör på VPS och läser sin konfiguration från /etc/bsk/bsk.env.
DATABASE_URL=

# --- Sessionssignering (krävs i produktion/staging) ---
# Generera t.ex. med: openssl rand -hex 32
SESSION_SECRET=
ADMIN_EMAIL=

# --- Google-inloggning för tränare ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Delad enbart mellan BSK-processen, betrodd VPS-proxy och Planlinjen.
BSK_SESSION_BRIDGE_SECRET=
