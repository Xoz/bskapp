# Miljövariabler för BSK-appen. Kopiera till .env.local för lokal utveckling.

# --- Databas (Supabase / Postgres) ---
# Connection string från Supabase: Project Settings → Database → Connection
# string → Transaction pooler (port 6543, krävs för serverless på Vercel).
# OBS: just nu finns bara ett Supabase-projekt (produktion) – lokal
# utveckling pekar mot SAMMA databas som produktionen tills en separat
# dev-databas finns. Var försiktig lokalt, detta är äkta lagdata.
DATABASE_URL=

# --- Sessionssignering (krävs i produktion/staging) ---
# Generera t.ex. med: openssl rand -hex 32
SESSION_SECRET=

# --- Google-inloggning för tränare ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (utvärderingsförslag + spelarintervju) ---
ANTHROPIC_API_KEY=
