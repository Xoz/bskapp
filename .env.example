# Miljövariabler för BSK-appen. Kopiera till .env.local för lokal utveckling.
# Utan TURSO_* används en lokal SQLite-fil (data/bsk.db) automatiskt.

# --- Databas (Turso / libSQL) ---
# Sätts i Vercel per miljö: Production → produktions-DB, Preview → staging-DB.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Sessionssignering (krävs i produktion/staging) ---
# Generera t.ex. med: openssl rand -hex 32
SESSION_SECRET=

# --- Google-inloggning för tränare ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (utvärderingsförslag + spelarintervju) ---
ANTHROPIC_API_KEY=
